#!/usr/bin/env python3
"""Privileged helper: rewrite /var/lib/console-settings/local-overrides.quirks.

Invoked only via pkexec. Takes a JSON array on stdin of
``[{"id_path": "...", "override_name": "..."}, ...]`` and writes the quirks
file atomically. The real path lives in /var (writable, bind-mounted from
the userdata partition); libinput reaches it via the
/etc/libinput/local-overrides.quirks symlink shipped by the recipe (the
rootfs is RO so /etc can't be written directly).

Rejects any entry with characters outside a strict allow-list — the daemon
builds payloads from udev ID_PATH values, which never contain anything
outside ``[A-Za-z0-9:._-]`` in practice; broader input is almost certainly
tampering and the helper runs as root so we hard-fail rather than guess.
"""

from __future__ import annotations

import json
import os
import re
import sys
import tempfile
from pathlib import Path

TARGET = Path("/var/lib/console-settings/local-overrides.quirks")
ID_PATH_RE = re.compile(r"^[A-Za-z0-9:._\-]+$")
NAME_RE = re.compile(r"^[A-Za-z0-9 :._\-]+$")
HEADER = (
    "# /var/lib/console-settings/local-overrides.quirks\n"
    "# Generated by console-settings-daemon — do not edit.\n"
    "# libinput reads this via /etc/libinput/local-overrides.quirks (symlink).\n"
    "\n"
)


def render(entries: list) -> str:
    out = [HEADER]
    seen: set = set()
    for e in entries:
        id_path = e["id_path"]
        override = e["override_name"]
        if id_path in seen:
            continue
        seen.add(id_path)
        out.append(f"[MDMX Touch @ {id_path}]\n")
        out.append("MatchUdevType=touchscreen\n")
        out.append(f"MatchUdevProperty=ID_PATH={id_path}\n")
        out.append(f"AttrDeviceNameOverride={override}\n")
        out.append("\n")
    return "".join(out)


def validate(entries) -> None:
    if not isinstance(entries, list):
        raise ValueError("payload must be a JSON array")
    for e in entries:
        if not isinstance(e, dict):
            raise ValueError("each entry must be an object")
        id_path = e.get("id_path")
        name = e.get("override_name")
        if not isinstance(id_path, str) or not ID_PATH_RE.match(id_path):
            raise ValueError(f"invalid id_path {id_path!r}")
        if not isinstance(name, str) or not NAME_RE.match(name):
            raise ValueError(f"invalid override_name {name!r}")


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError as exc:
        print(f"install-touch-quirks: bad JSON: {exc}", file=sys.stderr)
        return 2
    try:
        validate(payload)
    except ValueError as exc:
        print(f"install-touch-quirks: {exc}", file=sys.stderr)
        return 2

    TARGET.parent.mkdir(parents=True, mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".quirks.", dir=str(TARGET.parent))
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(render(payload))
        os.chmod(tmp, 0o644)
        os.replace(tmp, TARGET)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return 0


if __name__ == "__main__":
    sys.exit(main())
