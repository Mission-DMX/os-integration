// Grants the desktop `user` account three actions needed by
// console-settings-daemon when it commits the wizard result:
//   * pkexec on the install-touch-quirks helper — rewrites
//     /var/lib/console-settings/local-overrides.quirks after validating
//     the JSON payload against a strict allow-list;
//   * systemd manage-units on sway.service — the quirks file only takes
//     effect when libinput next opens the device, so the wizard restarts
//     sway as its final step;
//   * timedate1 set-timezone — called via `timedatectl set-timezone`
//     during both the wizard commit and the fast path (when the stored
//     zone differs from the current one).
// All three are allow-no-password: the operator is already physically
// present at a sway session, and there is no stronger auth factor on
// this kiosk.
polkit.addRule(function (action, subject) {
    if (subject.user !== "user") {
        return;
    }
    if (action.id === "org.freedesktop.policykit.exec"
        && action.lookup("program") === "/usr/libexec/console-settings-daemon/install-touch-quirks") {
        return polkit.Result.YES;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units"
        && action.lookup("unit") === "sway.service"
        && action.lookup("verb") === "restart") {
        return polkit.Result.YES;
    }
    if (action.id === "org.freedesktop.timedate1.set-timezone") {
        return polkit.Result.YES;
    }
});
