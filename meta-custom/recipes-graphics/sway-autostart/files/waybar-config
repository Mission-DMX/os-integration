{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["custom/fish", "cpu", "memory", "clock"],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false
    },
    "sway/window": {
        "max-length": 60
    },
    "custom/fish": {
        "exec": "cat /run/fish-monitor/status.json 2>/dev/null || echo '{\"text\":\" \",\"class\":\"unknown\",\"tooltip\":\"fish-monitor not running\"}'",
        "return-type": "json",
        "interval": 2,
        "on-click": "swaymsg '[app_id=\"fish-terminal\"] scratchpad show'"
    },
    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "MEM {percentage}%",
        "interval": 5
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "interval": 1
    }
}
