{
    "layer": "top",
    "position": "top",
    "height": 44,
    "spacing": 4,
    "modules-left": ["custom/launcher", "sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["custom/fish", "cpu", "memory", "clock", "custom/power"],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false
    },
    "sway/window": {
        "max-length": 60
    },
    "custom/launcher": {
        "format": " Apps ",
        "tooltip": true,
        "tooltip-format": "Tap to open the application launcher",
        "on-click": "swaymsg exec /usr/bin/application-launcher"
    },
    "custom/fish": {
        "exec": "cat \"${XDG_RUNTIME_DIR:-/tmp}/fish-monitor/status.json\" 2>/dev/null || echo '{\"text\":\" \",\"class\":\"unknown\",\"tooltip\":\"fish-monitor not running\"}'",
        "return-type": "json",
        "interval": 2,
        "on-click": "swaymsg '[app_id=\"fish-terminal\"] scratchpad show'"
    },
    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "MEM {percentage}%",
        "interval": 5
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "interval": 1
    },
    "custom/power": {
        "format": " ⏻ ",
        "tooltip": true,
        "tooltip-format": "Lock, reboot or shut down",
        "on-click": "swaymsg exec /usr/bin/console-menu"
    }
}
