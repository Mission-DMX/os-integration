[Unit]
Description=Sway Wayland Compositor
Documentation=man:sway(5)
After=seatd.service systemd-logind.service systemd-user-sessions.service
Wants=seatd.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=user
Group=user
# RuntimeDirectory creates /run/sway owned by User=user with mode 0700
# before the service starts. This replaces the fragile
# ExecStartPre=+/bin/install ... approach which was hanging on the
# earlier iteration (the `install` binary blocked while start-pre was
# also holding tty1, driving a restart loop).
RuntimeDirectory=sway
RuntimeDirectoryMode=0700
Environment=HOME=/home/user
Environment=LANG=en_US.UTF-8
# Point XDG_RUNTIME_DIR at /run/sway rather than /run/user/1000 so we
# don't collide with anything logind manages via pam_systemd. sway +
# libseat + seatd don't require a logind session — seatd (running as
# root, group=seat) hands us the DRM/input/tty fds directly.
Environment=XDG_RUNTIME_DIR=/run/sway
Environment=XDG_SESSION_TYPE=wayland
Environment=WLR_RENDERER=pixman
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYVHangup=yes
TTYVTDisallocate=yes
# StandardInput=tty gives sway /dev/tty1 as its controlling terminal.
# If the kernel VT is ever momentarily in KD_TEXT (before seatd flips it
# to KD_GRAPHICS, on a VT swap, on a wlroots renderer glitch, etc.), the
# tty line discipline turns a Ctrl-C keypress into SIGINT delivered to
# the tty1 foreground process group — which is sway. Default SIGINT
# action is termination, so pressing Ctrl-C inside a foot terminal has
# been observed to take down the whole session. Ignoring SIGINT (and
# SIGQUIT, same story via Ctrl-\) via `trap ""` before exec sets the
# disposition to SIG_IGN; POSIX preserves SIG_IGN across exec, so sway
# inherits it. Children (foot's shell, waybar, …) install their own
# handlers and so remain interruptible normally.
ExecStart=/bin/sh -c 'trap "" INT QUIT; exec /usr/bin/dbus-run-session -- /usr/bin/sway'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
