# short-description: MissionDMX A/B firmware image with GRUB-EFI (debug variant)
# long-description:
#   Identical partition layout to mdmx-ab.wks.in but with `nokaslr` baked
#   into the GRUB default kernel command line. Used by `make debug` so the
#   -kernel/-append trick that used to disable KASLR still applies now that
#   the kernel loads via GRUB instead of qemu -kernel.

bootloader --ptable gpt --timeout=3 --configfile=mdmx-grub-debug.cfg --append="console=ttyS0,115200 console=tty0 quiet nokaslr"

part /boot/efi --source bootimg-efi --sourceparams="loader=grub-efi,install-kernel-into-boot-dir=false" --label esp --part-name esp --active --align 1024 --fixed-size 128M --use-uuid --fstype=vfat

part / --source rootfs --ondisk sda --fstype=ext4 --label rootfsA --part-name rootfsA --align 1024 --fixed-size 16384M --use-uuid

part --ondisk sda --fstype=ext4 --label rootfsB --part-name rootfsB --align 1024 --fixed-size 16384M --use-uuid --no-fstab-update
