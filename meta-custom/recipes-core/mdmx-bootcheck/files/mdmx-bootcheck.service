[Unit]
Description=Mark current boot slot as good via RAUC (with grubenv fallback)
Documentation=man:rauc(1) man:grub-editenv(1)
After=graphical.target sway.service rauc.service
Wants=graphical.target
ConditionPathExists=/boot/efi/EFI/BOOT/grubenv

[Service]
Type=oneshot
ExecStart=/usr/sbin/mdmx-bootcheck.sh
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
